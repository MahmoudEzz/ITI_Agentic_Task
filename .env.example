# Copy to .env and fill in. No real secrets belong in this file or in git history.

# --- Server ---
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# --- Postgres (relational + pgvector) ---
DATABASE_URL=postgres://domain_copilot:domain_copilot@localhost:5432/domain_copilot

# --- LLM providers ---
# Primary: Ollama, local, free. Point at the compose service by default;
# override to host.docker.internal for faster local development against host Ollama.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Secondary: Google Gemini, hosted, genuinely free tier.
# Get a free key at https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provider fallback order, comma-separated. First is primary.
LLM_PROVIDER_CHAIN=ollama,gemini

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_REFUSAL_THRESHOLD=0.35

# --- OCR confidence thresholds (0-100, provisional pending Phase 5 tuning) ---
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_UNUSABLE_THRESHOLD=40
