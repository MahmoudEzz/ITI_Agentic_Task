# Copy to .env and fill in. No real secrets belong in this file or in git history.

# --- Server ---
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Comma-separated exact-origin allow-list for @fastify/cors. Empty means no
# browser origin is allowed (server-to-server/curl/tests are unaffected —
# CORS only governs browser-enforced cross-origin requests).
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Postgres (relational + pgvector) ---
# Host port is 5433, not Postgres's default 5432 — see docker-compose.yml.
# This is what `npm run migrate` / `npm run ingest` use from the host; the
# containerized `api` service connects to the `postgres` compose service
# directly instead (see docker-compose.yml's `api.environment`).
DATABASE_URL=postgres://domain_copilot:domain_copilot@localhost:5433/domain_copilot

# A separate database for `npm run test:integration`/`test:all` (only
# consulted when NODE_ENV=test — see env.js) — those tests truncate tables
# between cases, which would otherwise wipe whatever `npm run ingest` put in
# DATABASE_URL out from under local dev (issue #35). Created automatically
# by docker/init-test-db.sh on a fresh `docker compose up`; on an
# already-initialized volume, create it once with:
#   docker compose exec postgres psql -U domain_copilot -d domain_copilot -c "CREATE DATABASE domain_copilot_test;"
TEST_DATABASE_URL=postgres://domain_copilot:domain_copilot@localhost:5433/domain_copilot_test

# --- LLM providers ---
# Primary: Ollama, local, free. localhost:11434 is what `npm run ingest` and
# other host-side scripts use — same reasoning as DATABASE_URL above. The
# containerized `api` service overrides this to http://ollama:11434 itself
# (see docker-compose.yml's `api.environment`), so this value is never read
# by anything running inside the compose network.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Secondary: Google Gemini, hosted, genuinely free tier.
# Get a free key at https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provider fallback order, comma-separated. First is primary.
LLM_PROVIDER_CHAIN=ollama,gemini

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_REFUSAL_THRESHOLD=0.35

# --- OCR confidence thresholds (0-100, provisional pending Phase 5 tuning) ---
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_UNUSABLE_THRESHOLD=40

# --- Upload validation ---
MAX_UPLOAD_SIZE_BYTES=20971520
