{
  "name": "domain-copilot",
  "version": "0.1.0",
  "description": "Domain Copilot — an agentic RAG platform for HR talent screening (ITI Instructor Task, variant D6T6)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/adapters/http/server.js",
    "start": "node src/adapters/http/server.js",
    "migrate": "knex migrate:latest --knexfile src/infra/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/infra/db/knexfile.js",
    "seed": "node src/infra/db/seed.js",
    "ingest": "node scripts/ingest.js",
    "eval": "node scripts/eval.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:contract": "node --test \"tests/contract/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:all": "node --test \"tests/{unit,contract,integration}/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
